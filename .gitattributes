# The repo is developed on Windows and run on Linux (WSL2, Docker, ECS).
# Without this, a Windows checkout rewrites every file to CRLF and
# `#!/usr/bin/env bash` becomes `bash\r`, which is not a program:
#   /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf

# Never let these be rewritten, on any platform.
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
Dockerfile*  text eol=lf

*.jpg binary
*.png binary
*.svg text eol=lf
